{
  "name": "vscode-copilot-status-bar",
  "displayName": "Copilot Status Bar",
  "description": "Lightweight Copilot token usage meter in the VSCode status bar.",
  "version": "1.0.0",
  "publisher": "Appforge",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#07113f",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/klaevv/vscode-copilot-status-bar.git"
  },
  "homepage": "https://github.com/klaevv/vscode-copilot-status-bar#readme",
  "bugs": {
    "url": "https://github.com/klaevv/vscode-copilot-status-bar/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": [
    "copilot",
    "github copilot",
    "premium requests",
    "quota",
    "usage",
    "status bar"
  ],
  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "copilotStatusBar.refresh", "title": "Copilot Status Bar: Refresh" },
      { "command": "copilotStatusBar.showUsage", "title": "Copilot Status Bar: Show Usage" },
      { "command": "copilotStatusBar.signIn", "title": "Copilot Status Bar: Sign In to GitHub" },
      { "command": "copilotStatusBar.showLog", "title": "Copilot Status Bar: Show Log" },
      { "command": "copilotStatusBar.setRefreshInterval", "title": "Copilot Status Bar: Set Refresh Interval" }
    ],
    "configuration": {
      "title": "Copilot Status Bar",
      "properties": {
        "copilotStatusBar.refreshIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "description": "How often to re-fetch Copilot quota from GitHub, in seconds."
        },
        "copilotStatusBar.countdownUpdateIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "How often to refresh the status bar's 'resets in' countdown between quota fetches, in seconds. Does not make a network request."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test",
    "check": "npm test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:marketplace": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
